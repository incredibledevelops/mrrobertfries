# ============================================
# Mr. Robert's Fries — Backend Environment
# ============================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — only commit `.env.example`.

# ---------- App ----------
APP_NAME="Mr. Robert's Fries API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000

# ---------- MongoDB ----------
# Local:
MONGODB_URL=mongodb://localhost:27017
# Production (MongoDB Atlas):
# MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mr_roberts_fries

# ---------- Redis (optional — omit to disable caching) ----------
# Local:
REDIS_URL=redis://localhost:6379/0
# Production (Upstash / Railway / Redis Cloud):
# REDIS_URL=rediss://default:PASSWORD@host:port
CACHE_TTL_SECONDS=60

# ---------- JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CUSTOMER_TOKEN_EXPIRE_DAYS=30
CUSTOMER_REFRESH_EXPIRE_DAYS=90
CUSTOMER_OTP_EXPIRE_MINUTES=10

# ---------- Paystack ----------
# Get keys from https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Test keys start with "sk_test_" and "pk_test_"
# Live keys start with "sk_live_" and "pk_live_"
PAYSTACK_SECRET_KEY=your-paystack-secret-key-from-dashboard
PAYSTACK_PUBLIC_KEY=your-paystack-public-key-from-dashboard
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/order/callback
# Production:
# PAYSTACK_CALLBACK_URL=https://mrfries.com/order/callback

# ---------- CORS ----------
# Comma-separated list. No spaces.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# Production:
# CORS_ORIGINS=https://mrfries.com,https://www.mrfries.com

# ---------- File uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Cloudinary (optional — for production image hosting)
# Sign up at https://cloudinary.com → Dashboard → Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Business ----------
DEFAULT_DELIVERY_FEE=15.00
CURRENCY=GHS

# ---------- Email (Resend) ----------
# Sign up at https://resend.com → API Keys
RESEND_API_KEY=
MAIL_FROM=Mr. Robert's Fries <onboarding@resend.dev>
# Production (after verifying your domain):
# MAIL_FROM=Mr. Robert's Fries <hello@mrfries.com>
MAIL_FROM_NAME=Mr. Robert's Fries

# ---------- SMS (Arkesel) ----------
# Sign up at https://arkesel.com → Developer → API Keys
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=MrRobertsFries
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# ---------- Loyalty program ----------
LOYALTY_POINTS_PER_CEDI=1
LOYALTY_POINTS_TO_CEDI=0.01
LOYALTY_MIN_REDEEM=100